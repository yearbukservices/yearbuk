# Database
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signed URL Configuration (in seconds)
SIGNED_URL_EXPIRY=300

# Session Secret
SESSION_SECRET=

# Encryption
ENCRYPTION_KEY=

# Application URL (optional; forwarded host is used when unset)
APP_DOMAIN=

# Replit/runtime
PORT=5000

# Pricing (in USD)
SCHOOL_YEAR_PRICE=16.99
VIEWER_YEAR_PRICE=6.99
BADGE_SLOT_PRICE=0.99

# Super Admin Credentials
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# Email Configuration (SendGrid/SMTP)
EMAIL_SERVICE=
EMAIL_FROM=
SENDGRID_API_KEY=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payment and upload verification
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Runtime modes
TEST_MODE=false
USE_SANDBOX_MODE=false
